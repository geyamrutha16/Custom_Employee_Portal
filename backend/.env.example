# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=employee_portal

# --- Auth ---
# Generate a long random string for production, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=2h
COOKIE_NAME=portal_token

# --- Zoho integration (per-employee OAuth, redirect to real Zoho app) ---
# First click sends the employee through Zoho's own login/consent screen (Zoho
# skips it automatically on later clicks if their session/consent is still valid);
# we store their encrypted refresh_token, then send them into the real Zoho app
# (see src/controllers/zohoOAuth.controller.js).
# Register a Server-based Application in the Zoho API Console with
# redirect_uri = ZOHO_REDIRECT_URI below, and fill in its client ID/secret.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com
ZOHO_DESK_API_BASE_URL=https://desk.zoho.com
ZOHO_DESK_ORG_ID=
ZOHO_REDIRECT_URI=http://localhost:4000/api/zoho/oauth/callback

# Where the employee lands after granting consent — the real Zoho web app.
ZOHO_CRM_PORTAL_URL=https://crm.zoho.com/crm/
ZOHO_DESK_PORTAL_URL=https://desk.zoho.com/

# 32-byte key (base64) that encrypts the stored Zoho refresh tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
