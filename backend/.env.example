# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=employee_portal

# --- Auth ---
# Generate a long random string for production, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=2h
COOKIE_NAME=portal_token

# --- Zoho integration ---
# Leave ZOHO_DEMO_MODE=true until real Zoho OAuth credentials are configured and verified.
ZOHO_DEMO_MODE=true
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_REDIRECT_URI=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com
# Zoho Desk has its own API domain (not www.zohoapis.*).
# Match the TLD to your data center, same as the two URLs above.
ZOHO_DESK_API_BASE_URL=https://desk.zoho.com
# Required by Zoho Desk. Find it under Zoho Desk > Setup > Developer Space > API.
ZOHO_DESK_ORG_ID=
